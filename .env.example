# Hoster environment
# Copy this file to .env and adjust values.

# SQLite database file (Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Optional: usage budget alert threshold ladders (comma-separated numbers).
# Default hour thresholds: 2,6,12 instance-hours (info pacing)
# Default cost thresholds: 0.10,0.50,2.00 equivalent $ (warn/warn/error)
# NX_USAGE_ALERT_HOUR_THRESHOLDS=2,6,12
# NX_USAGE_ALERT_COST_THRESHOLDS=0.1,0.5,2.0
